{
  "name": "human-verified-news-platform",
  "version": "1.0.0",
  "description": "A human-verified news commentary platform with Alien.org authentication",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @hvnp/backend",
    "dev:frontend": "npm run dev -w @hvnp/frontend",
    "build": "npm run build -w @hvnp/shared && npm run build -w @hvnp/backend && npm run build -w @hvnp/frontend",
    "build:backend": "npm run build -w @hvnp/backend",
    "build:frontend": "npm run build -w @hvnp/frontend",
    "start": "npm run start -w @hvnp/backend",
    "db:migrate": "npm run db:migrate -w @hvnp/backend",
    "db:seed": "npm run db:seed -w @hvnp/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
