# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hvnp_dev?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Alien.org Integration
ALIEN_API_URL=https://api.alien.org
ALIEN_APP_ID=your-alien-app-id
ALIEN_APP_SECRET=your-alien-app-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# News Crawler
NEWS_CRAWLER_INTERVAL_MS=900000
