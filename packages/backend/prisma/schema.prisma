// Prisma schema for Human-Verified News Commentary Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - tied to Alien.org verification
model User {
  id          String   @id @default(uuid())
  alienId     String   @unique @map("alien_id")
  displayName String   @unique @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  karma       Int      @default(0)
  isVerified  Boolean  @default(true) @map("is_verified")
  isBanned    Boolean  @default(false) @map("is_banned")
  banReason   String?  @map("ban_reason")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  comments Comment[]
  votes    Vote[]
  sessions Session[]
  reports  Report[]  @relation("ReportedBy")
  reviews  Report[]  @relation("ReviewedBy")

  @@map("users")
}

// Session model for user authentication
model Session {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  userAgent      String?  @map("user_agent")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// News source (publishers like CNN, BBC, etc.)
model NewsSource {
  id         String      @id @default(uuid())
  name       String      @unique
  domain     String      @unique
  rssUrl     String?     @map("rss_url")
  logoUrl    String?     @map("logo_url")
  biasRating BiasRating? @map("bias_rating")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  // Relations
  articles NewsArticle[]

  @@map("news_sources")
}

// Bias rating enum
enum BiasRating {
  FAR_LEFT
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
  FAR_RIGHT

  @@map("bias_rating")
}

// Individual news articles from sources
model NewsArticle {
  id          String   @id @default(uuid())
  sourceId    String   @map("source_id")
  eventId     String?  @map("event_id")
  title       String
  url         String   @unique
  summary     String?
  imageUrl    String?  @map("image_url")
  author      String?
  publishedAt DateTime @map("published_at")
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  // Relations
  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  event  NewsEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([eventId])
  @@index([publishedAt])
  @@map("news_articles")
}

// News event - aggregated story from multiple sources
model NewsEvent {
  id           String       @id @default(uuid())
  slug         String       @unique
  title        String
  summary      String
  category     NewsCategory
  imageUrl     String?      @map("image_url")
  commentCount Int          @default(0) @map("comment_count")
  isTrending   Boolean      @default(false) @map("is_trending")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  articles NewsArticle[]
  comments Comment[]

  @@index([category])
  @@index([createdAt])
  @@index([isTrending])
  @@map("news_events")
}

// News category enum
enum NewsCategory {
  POLITICS
  TECHNOLOGY
  BUSINESS
  SCIENCE
  HEALTH
  SPORTS
  ENTERTAINMENT
  WORLD
  ENVIRONMENT
  OTHER

  @@map("news_category")
}

// Comments on news events
model Comment {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  authorId   String   @map("author_id")
  parentId   String?  @map("parent_id")
  content    String
  score      Int      @default(0)
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  depth      Int      @default(0)
  isEdited   Boolean  @default(false) @map("is_edited")
  editedAt   DateTime? @map("edited_at")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  event   NewsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  votes   Vote[]
  reports Report[]

  @@index([eventId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([score])
  @@map("comments")
}

// Votes on comments
model Vote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  type      VoteType
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("votes")
}

// Vote type enum
enum VoteType {
  UP
  DOWN

  @@map("vote_type")
}

// Reports for content moderation
model Report {
  id          String       @id @default(uuid())
  reporterId  String       @map("reporter_id")
  commentId   String       @map("comment_id")
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?      @map("reviewed_by")
  reviewedAt  DateTime?    @map("reviewed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  // Relations
  reporter User    @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([commentId])
  @@index([status])
  @@map("reports")
}

// Report reason enum
enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  MISINFORMATION
  OFF_TOPIC
  OTHER

  @@map("report_reason")
}

// Report status enum
enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED

  @@map("report_status")
}
